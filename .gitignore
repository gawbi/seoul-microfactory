node_modules
dist
*.local
.DS_Store
# 원본 고해상도 사진은 용량 때문에 저장소에 올리지 않는다.
# 다시 받는 방법은 public/assets/images/go2/IMAGE_CREDITS.md 참고.
media-src/**/originals/

# Isaac Sim 출력물 (프레임, 로그). 최종 결과만 public/assets/simulation/으로 복사한다.
sim/output/*
# 다시 학습한 Go2 보행 정책(작은 TorchScript 파일)만 저장소에 둔다
!sim/output/policies/
sim/output/policies/*
!sim/output/policies/go2_upright/
sim/output/policies/go2_upright/*
!sim/output/policies/go2_upright/policy.pt
!sim/output/policies/go2_upright/policy.sha256

# 개인 설정 문서
claude_setup.md
__pycache__/
